    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SaveConvert</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>save-convert</AssemblyName>
    <AssemblyTitle>Game Save Convert</AssemblyTitle>
